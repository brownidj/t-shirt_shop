{
  "name": "topository-responsive-tests",
  "private": true,
  "scripts": {
    "test:responsive": "scripts/run_responsive_tests.sh",
    "test:responsive:ci": "RESPONSIVE_NO_SNAPSHOTS=1 scripts/run_responsive_tests.sh",
    "test:responsive:update": "scripts/run_responsive_tests.sh --update-snapshots",
    "test:responsive:ui": "playwright test --ui",
    "test:responsive:live": "LIVE_SMOKE=1 BASE_URL=https://tshirts.topository.org playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
