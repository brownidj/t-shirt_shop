{
  "name": "topository-responsive-tests",
  "private": true,
  "scripts": {
    "test:responsive": "playwright test",
    "test:responsive:ci": "RESPONSIVE_NO_SNAPSHOTS=1 playwright test",
    "test:responsive:update": "playwright test --update-snapshots",
    "test:responsive:ui": "playwright test --ui",
    "test:responsive:live": "LIVE_SMOKE=1 BASE_URL=https://tshirts.topository.org playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
